{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "calendario-eventi-condiviso",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-08-19",
	// postgres.js usa le API socket di Node: senza questo flag non si connette.
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true
	}
	// Le variabili d'ambiente NON stanno qui: sono secret del Worker.
	// Vedi README.md, sezione "Deploy".
}
