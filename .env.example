# Copia questo file in `.env` e valorizzalo. `.env` è in .gitignore.
# ATTENZIONE: il prefisso PUBLIC_ in SvelteKit significa "esposto al browser".
# Mai usarlo per chiavi server.

# --- Supabase (progetto in una region UE) ---
PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Database ---
# Runtime: pooler Supavisor, porta 6543, transaction mode.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-<region>.pooler.supabase.com:6543/postgres
# Solo migrazioni: connessione diretta, porta 5432. Mai usata a runtime.
DIRECT_DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Email (Fase 6) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Paste-to-parse (Fase 5) ---
LLM_API_KEY=
LLM_MODEL=

# --- Geocoding (Fase 1) ---
GEOCODER_BASE_URL=https://photon.komoot.io
# Richiesto dalla policy Nominatim: contatto reale del manutentore.
GEOCODER_USER_AGENT=

# --- Cron (Fase 3) ---
# Segreto condiviso con le GitHub Actions, inviato in header `x-cron-secret`.
CRON_SECRET=

# --- App ---
PUBLIC_APP_URL=http://localhost:5173
