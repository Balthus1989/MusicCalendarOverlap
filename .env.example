# Copia questo file in `.env` e valorizzalo. `.env` è in .gitignore.
# ATTENZIONE: il prefisso PUBLIC_ in SvelteKit significa "esposto al browser".
# Mai usarlo per chiavi server.

# --- Supabase (progetto in una region UE) ---
PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Database ---
# Runtime: pooler Supavisor, porta 6543, transaction mode.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-<region>.pooler.supabase.com:6543/postgres
# Solo migrazioni, porta 5432. Mai usata a runtime.
# Deve puntare al pooler in *session mode*, cioè allo stesso host di sopra sulla
# 5432 — non a `db.<ref>.supabase.co`, che risponde solo su IPv6 e da una rete
# senza IPv6 lascia `drizzle-kit migrate` appeso senza errore. Vedi il runbook.
DIRECT_DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Notifiche via Telegram (Fase 6) ---
# Il token che restituisce @BotFather con /newbot. Senza, il layer registra gli
# avvisi in pagina e li lascia in coda: non e' un guasto, e' lo stato normale in
# locale (ADR-0039).
TELEGRAM_BOT_TOKEN=
# Lo username del bot, senza @. Serve solo a costruire il link "apri il bot"
# nella pagina delle impostazioni: senza, il codice si copia a mano.
TELEGRAM_BOT_USERNAME=

# --- Paste-to-parse (Fase 5) ---
# Chiave della Claude API (console.anthropic.com). Senza, l'incolla di testo
# libero resta spento e lo dice; i file .ics e i CSV si leggono lo stesso,
# perché non passano da nessun modello.
LLM_API_KEY=
# Vuota significa claude-haiku-4-5, che e' quello che ARCHITECTURE.md §9
# prescrive e che tiene il costo nell'ordine di 1-2 euro l'anno. Si cambia da
# qui, senza toccare il codice (ADR-0034).
LLM_MODEL=

# --- Geocoding (Fase 1) ---
GEOCODER_BASE_URL=https://photon.komoot.io
# Richiesto dalla policy Nominatim: contatto reale del manutentore.
GEOCODER_USER_AGENT=

# --- Cron (Fase 3) ---
# Segreto condiviso con le GitHub Actions, inviato in header `x-cron-secret`.
CRON_SECRET=

# --- App ---
PUBLIC_APP_URL=http://localhost:5173
