{
	"name": "calendario-eventi-condiviso",
	"private": true,
	"version": "0.6.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:seed": "tsx db/seeds/run.ts",
		"db:seed:demo": "tsx db/seeds/demo.ts",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"deploy": "node scripts/controlla-cartella.mjs && npm run build && wrangler deploy",
		"rilascia": "node scripts/rilascia.mjs"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.120.0",
		"@fullcalendar/core": "^6.1.21",
		"@fullcalendar/daygrid": "^6.1.21",
		"@fullcalendar/list": "^6.1.21",
		"@fullcalendar/timegrid": "^6.1.21",
		"@supabase/ssr": "^0.12.4",
		"@supabase/supabase-js": "^2.86.0",
		"drizzle-orm": "^0.45.0",
		"ical-generator": "^11.1.0",
		"postgres": "^3.4.7",
		"zod": "^4.1.13"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.1.16",
		"@types/node": "^24.10.1",
		"clsx": "^2.1.1",
		"dotenv": "^17.2.4",
		"drizzle-kit": "^0.31.10",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.14.0",
		"globals": "^16.5.0",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwind-merge": "^3.3.1",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.1.16",
		"tsx": "^4.23.12",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.46.0",
		"vite": "^8.0.16",
		"vitest": "^4.1.11"
	}
}
